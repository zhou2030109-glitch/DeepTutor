<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeepTutor</AssemblyName>
    <RootNamespace>DeepTutor.Desktop</RootNamespace>
    <Product>DeepTutor Desktop</Product>
    <Description>DeepTutor Windows desktop application</Description>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\DeepTutor.ico</ApplicationIcon>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <Resource Include="Assets\DeepTutor.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
</Project>
